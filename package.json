{
  "name": "assetfare-mcp",
  "version": "0.3.0",
  "description": "Optional MCP and quote-only A2A v1 discovery adapters for AssetFare's non-custodial four-chain REST/OpenAPI v2 route service.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "assetfare-mcp": "src/server.js",
    "assetfare-route-eval": "scripts/route-eval.mjs"
  },
  "files": [
    "src",
    "scripts",
    "skills",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "server.json"
  ],
  "mcpName": "io.github.odaiin/assetfare",
  "repository": {
    "type": "git",
    "url": "https://github.com/odaiin/assetfare-mcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "test": "node src/selftest.js && node src/a2a-selftest.js",
    "a2a-test": "node src/a2a-selftest.js",
    "first-call-eval": "node scripts/first-call-eval.mjs",
    "route-eval": "node scripts/route-eval.mjs",
    "route-eval-selftest": "node scripts/route-eval-selftest.mjs"
  }
}
