{
  "name": "assetfare-mcp",
  "version": "0.4.2",
  "description": "Read-only MCP and A2A quote adapters for AssetFare's non-custodial five-chain source REST/OpenAPI v2 route service.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "assetfare-mcp": "src/server.js",
    "assetfare-route-eval": "scripts/route-eval.mjs"
  },
  "files": [
    "src",
    "scripts",
    "skills",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "server.json"
  ],
  "mcpName": "io.github.odaiin/assetfare",
  "repository": {
    "type": "git",
    "url": "https://github.com/odaiin/assetfare-mcp.git"
  },
  "keywords": [
    "ai-agents",
    "route-quotes",
    "cross-chain",
    "bridge",
    "swap",
    "solana",
    "base",
    "arbitrum",
    "robinhood-chain",
    "polygon",
    "mcp",
    "a2a",
    "openapi",
    "non-custodial"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/v2-selftest.js && node --check scripts/first-call-eval.mjs && node --check scripts/agent-plugin-selftest.mjs",
    "test": "node src/selftest.js && node src/v2-selftest.js && node src/a2a-selftest.js && node scripts/agent-plugin-selftest.mjs",
    "a2a-test": "node src/a2a-selftest.js",
    "first-call-eval": "node scripts/first-call-eval.mjs",
    "route-eval": "node scripts/route-eval.mjs",
    "route-eval-selftest": "node scripts/route-eval-selftest.mjs"
  }
}
