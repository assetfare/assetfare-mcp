  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "assetfare-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.assetfare.dev/mcp"
    }
  ]
}
